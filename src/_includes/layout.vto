<!DOCTYPE html>
<html lang="{{lang || 'en'}}">
{{ include "layouts/website/components/head.vto" }}
<body class="">
  {{ include "layouts/website/components/header.vto" }}
  <main id="content" class="is-full-screen container" role="main" {{ if !unlisted && !search_page && url !== "/404.html" && url !== "/contact/success/" }}data-pagefind-body{{ /if }}>
    {{ if !unlisted && url !== "/" && url !== "/404.html" }}
      {{ include "layouts/website/components/breadcrumbs.vto" }}
    {{ /if }}
    {{ for preItemName of preIncludeItems }}
      {{ include `${preItemName}.vto` }}
    {{ /for }}
    {{ set page_body }}
      {{ if type === "project" }}
        {{ include "layouts/website/components/project_body.vto" }}
      {{ else }}
        {{ content }}
      {{ /if }}
    {{ /set }}
    {{ if type === "project" && (page_body.match(/<h[23]\b/g) || []).length > 1 }}
      <details class="page-toc" data-pagefind-ignore>
        <summary>On This Page</summary>
        <nav toc="page-body" aria-label="Table of contents"></nav>
      </details>
    {{ /if }}
    <div id="page-body">{{ page_body }}</div>
    {{ for postItemName of postIncludeItems }}
      {{ include `${postItemName}.vto` }}
    {{ /for }}
  </main>
  {{ include "layouts/website/components/footer.vto" }}
</body>
</html>
