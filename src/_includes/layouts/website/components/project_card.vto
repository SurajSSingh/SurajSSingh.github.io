{{ if start_new_row && !ignore_row_div }}
<div class="divider col-12"></div>
{{ /if }}
<article class="col card no-border">
    {{ set card_links = (links || []).filter(item => item.link) }}
    {{ set link = card_links.find(item => item.name === "Home")?.link || card_links[0]?.link || project_link || link }}
    {{ set cover = cover_image?.file || image }}
    {{ layout "link_wrap.vto" {link} }}
        <h3 class="is-center">{{title}}</h3>
        {{ if cover }}
            <img src="{{cover}}" alt="{{cover_image?.alt_text || alt || title}}" class="is-center" />
        {{ /if }}
    {{ /layout }}
    {{ if student }}
        {{ set student_link = student_page || student_github || '' }}
        <p><b>Student: 
            {{ if link }}
                <a href="{{student_link}}">{{student}}</a>
            {{ else }}
                <span>{{student}}</span>
            {{ /if }}
        </b></p>
    {{ /if }}
    <p>{{summary}}</p>
    {{ if card_links.length }}
        <section class="row is-center links">
            {{ for item of card_links }}
                <a href="{{item.link}}" class="col text-center">{{item.name}}</a>
            {{ /for }}
        </section>
    {{ /if }}
    {{ if url }}
        <p><a href="{{url}}">Learn More...</a></p>
    {{ /if }}
</article>
