{{- set label = (item.name || "").toLowerCase() -}}
{{- set host = item.link.match(/^(?:https?:)?\/\/([^/?#:]+)/i)?.[1]?.toLowerCase() || "" -}}
{{- set link_icons = { "github repo": "github", "github": "github", "gitlab repo": "gitlab", "gitlab": "gitlab", "itch.io": "itchdotio", "netlify": "netlify", "vercel": "vercel" } -}}
{{- set brand = Object.hasOwn(link_icons, label) ? link_icons[label] : "" -}}
{{- set brand = brand || (/^(www\.)?github\.com$/.test(host) ? "github" : /^(www\.)?gitlab\.com$/.test(host) ? "gitlab" : /(^|\.)itch\.io$/.test(host) ? "itchdotio" : "") -}}
{{- if brand -}}
  <img src='{{ brand |> icon("simpleicons") }}' alt="" width="20" height="20" fill="currentColor" inline>
{{- else -}}
  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" focusable="false">
    {{- if label.includes("download") -}}
      <path d="M12 3v12m-5-5 5 5 5-5M4 16v5h16v-5" />
    {{- else if label.includes("demo") -}}
      <circle cx="12" cy="12" r="9" /><path d="m10 8 6 4-6 4z" />
    {{- else if label.includes("article") -}}
      <path d="M6 3h9l4 4v14H6zM14 3v5h5M9 12h7M9 16h7" />
    {{- else -}}
      <circle cx="12" cy="12" r="9" /><ellipse cx="12" cy="12" rx="4" ry="9" /><path d="M3 12h18" />
    {{- /if -}}
  </svg>
{{- /if -}}
