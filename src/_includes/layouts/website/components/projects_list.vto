{{ layout "layout.vto" }}
    {{ content }}
    {{ set projects = search.pages("type=project", "weight") }}
    <h2>Freelance</h2>
    <section class="row">
        {{ for post of projects.filter(post => ["freelance", "p1", "speakflow"].includes(post.org_id || post.org)) }}
            {{ include "layouts/website/components/project_card.vto" {...post} }}
        {{ /for }}
    </section>
    
    <h2>Personal Projects</h2>
    <section class="row">
        {{ for post of projects.filter(post => (post.org_id || post.org) === "personal") }}
            {{ include "layouts/website/components/project_card.vto" {...post} }}
        {{ /for }}
    </section>

    <hgroup>
        <h2>Coding Minds:</h2>
        <p>Explore <a href="/org/coding-minds/">my work at Coding Minds Academy</a>, including mentored student projects, Unity curriculum templates, and Python curriculum examples.</p>
    </hgroup>
    {{ set coding_minds_projects = projects.filter(post => (post.org_id || post.org) === "coding-minds") }}
    {{ if coding_minds_projects.length }}
    <section class="row">
        {{ for post of coding_minds_projects }}
            {{ include "layouts/website/components/project_card.vto" {...post} }}
        {{ /for }}
    </section>
    {{ /if }}

    <hgroup>
        <h2>School Projects</h2>
        <p>Projects I have worked on for school. This includes my undergraduate work at <a href="/org/uci/">University of California, Irvine (UCI)</a> and graduate work at <a href="/org/uiuc/">University of Illinois Urbana-Champaign (UIUC)</a></p>
    </hgroup>
    <section class="row">
        {{ for post of projects.filter(post => ["uci", "uiuc"].includes(post.org_id || post.org)) }}
            {{ include "layouts/website/components/project_card.vto" {...post} }}
        {{ /for }}
    </section>

    {{ set other_projects = projects.filter(post => !["personal", "freelance", "p1", "speakflow", "coding-minds", "uci", "uiuc"].includes(post.org_id || post.org)) }}
    {{ if other_projects.length > 0 }}
        <h2>Other Projects</h2>
        <section class="row">
            {{ for post of other_projects }}
                {{ include "layouts/website/components/project_card.vto" {...post} }}
            {{ /for }}
        </section>
    {{ /if }}
{{ /layout }}
