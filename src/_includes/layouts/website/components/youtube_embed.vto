{{ set video_id = (() => {
    const value = String(link || "").trim();
    const valid_id = /^[A-Za-z0-9_-]{11}$/;
    if (valid_id.test(value)) return value;
    try {
        const url = new URL(value);
        if (!["http:", "https:"].includes(url.protocol)) return "";
        let id = "";
        if (url.hostname === "youtu.be") {
            id = url.pathname.match(/^\/([A-Za-z0-9_-]{11})\/?$/)?.[1] || "";
        } else if (["youtube.com", "www.youtube.com", "m.youtube.com", "youtube-nocookie.com", "www.youtube-nocookie.com"].includes(url.hostname)) {
            id = url.pathname === "/watch"
                ? url.searchParams.get("v") || ""
                : url.pathname.match(/^\/(?:embed|shorts)\/([A-Za-z0-9_-]{11})\/?$/)?.[1] || "";
        }
        return valid_id.test(id) ? id : "";
    } catch {
        return "";
    }
})() }}
{{ if video_id }}
<iframe
    {{ if width }}
    width="{{width}}" 
    {{ /if }}
    {{ if height }}
    height="{{height}}"     
    {{ /if }}
    src="https://www.youtube-nocookie.com/embed/{{video_id}}"
    title="{{title}}" 
    frameborder="0" 
    referrerpolicy="strict-origin-when-cross-origin" 
    allowfullscreen
>
</iframe>
{{ else }}
<a href="{{link |> escape}}">{{ (title || link) |> escape }}</a>
{{ /if }}
