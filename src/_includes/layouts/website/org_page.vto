{{ layout "layout.vto" }}
<article class="org-page">
    <header class="card">
        <hgroup>
            {{ if logo }}
            <img src="{{ logo }}" alt="{{ title }} logo" class="org-logo" />
            {{ /if }}
            <h1>{{ title }}</h1>
            {{ if summary }}
            <p>{{ summary }}</p>
            {{ /if }}
        </hgroup>
        {{ if org_url }}
        <p><a href="{{ org_url }}" target="_blank" rel="noopener noreferrer">Visit {{ title }}</a></p>
        {{ /if }}
        {{ if content }}
        <div class="org-description">{{ content }}</div>
        {{ else }}
        <p class="content-pending"><strong>Content to be added:</strong> The background, work, and contributions associated with {{ title }} still need to be written.</p>
        {{ /if }}
    </header>

    <section class="org-projects">
        <h2>Related Projects</h2>
        {{ set org_projects = search.pages("type=project", "weight").filter(post => (post.org_id || post.org) === id || project_id?.includes(post.id)) }}
        {{ if org_projects.length > 0 }}
        <div class="row">
            {{ for post of org_projects }}
                {{ include "layouts/website/components/project_card.vto" {...post} }}
            {{ /for }}
        </div>
        {{ else }}
        <p>No projects found for this organization.</p>
        {{ /if }}
    </section>
    {{ set related_skills = search.pages("type=skill", "title").filter(skill => org_projects.some(post => post.skill_id?.includes(skill.id) || post.skills?.includes(skill.id) || post.skills?.includes(skill.title))) }}
    {{ if related_skills.length }}
    <section class="related-skills">
        <h2>Related Skills</h2>
        <ul>
            {{ for skill of related_skills }}
            <li><a href="{{ skill.url }}">{{ skill.title }}</a></li>
            {{ /for }}
        </ul>
    </section>
    {{ /if }}
</article>
{{ /layout }}
