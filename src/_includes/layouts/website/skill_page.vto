{{ layout "layout.vto" }}
<article class="skill-page">
    <header class="card">
        <hgroup>
            {{ if icon || image }}
            <img src="{{ icon || image }}" alt="{{ title }} icon" class="skill-icon" />
            {{ /if }}
            <h1>{{ title }}</h1>
            {{ if category }}
            <p class="skill-category"><em>{{ category }}</em></p>
            {{ /if }}
            {{ if summary }}
            <p>{{ summary }}</p>
            {{ /if }}
        </hgroup>
        {{ if skills_url }}
        <p><a href="{{ skills_url }}" target="_blank" rel="noopener noreferrer">Learn more about {{ title }}</a></p>
        {{ /if }}
        {{ if content }}
        <div class="skill-description">{{ content }}</div>
        {{ else }}
        <p class="content-pending"><strong>Content to be added:</strong> Experience with {{ title }}, contributions, and lessons learned still need to be written.</p>
        {{ /if }}
    </header>

    <section class="skill-projects">
        <h2>Related Projects</h2>
        {{ set skill_projects = search.pages("type=project", "weight").filter(post => post.skill_id?.includes(id) || post.skills?.includes(id) || post.skills?.includes(title)) }}
        {{ if skill_projects.length > 0 }}
        <div class="row">
            {{ for post of skill_projects }}
                {{ include "layouts/website/components/project_card.vto" {...post} }}
            {{ /for }}
        </div>
        {{ else }}
        <p>No projects found using this skill.</p>
        {{ /if }}
    </section>
    {{ set related_orgs = search.pages("type=organization", "title").filter(org => skill_projects.some(post => (post.org_id || post.org) === org.id || org.project_id?.includes(post.id))) }}
    {{ if related_orgs.length }}
    <section class="related-organizations">
        <h2>Related Organizations</h2>
        <ul>
            {{ for org of related_orgs }}
            <li><a href="{{ org.url }}">{{ org.title }}</a></li>
            {{ /for }}
        </ul>
    </section>
    {{ /if }}
</article>
{{ /layout }}
